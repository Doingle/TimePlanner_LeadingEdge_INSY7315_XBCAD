<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="Views\CheckInPopupView.xaml" />
    <Page Remove="Views\SettingsView.xaml" />
    <Page Remove="Views\TimesheetReviewView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Views\SettingsView.xaml" />
    <ApplicationDefinition Include="Views\TimesheetReviewView.xaml" />
    <ApplicationDefinition Include="Views\CheckInPopupView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

</Project>
