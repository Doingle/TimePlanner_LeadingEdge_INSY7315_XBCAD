<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<!-- Per-monitor DPI awareness (see app.manifest), so the widget stays sharp on every display -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assests\insy.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageReference Include="NAudio.Core" Version="2.2.1" />
		<PackageReference Include="NAudio.WinMM" Version="2.2.1" />
		<PackageReference Include="Whisper.net" Version="1.9.1" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TimePlanner.Core\TimePlanner.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The tray icon loads it as Assets/insy.ico -->
		<Resource Include="Assests\insy.ico" Link="Assets\insy.ico" />
	</ItemGroup>

	<!-- sample day for testing -->
	<ItemGroup>
		<None Update="SampleData\sample-day.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Ai\instructions.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Ai\examples.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>