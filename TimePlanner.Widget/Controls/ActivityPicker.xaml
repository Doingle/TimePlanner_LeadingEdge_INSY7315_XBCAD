<UserControl x:Class="TimePlanner.Widget.Controls.ActivityPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
             Focusable="False">
    <UserControl.Resources>
        <!-- One row of the dropdown: the label fills it, and the row builds its own check, chevron and actions -->
        <Style x:Key="Picker.Row" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{StaticResource Space32}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bg" CornerRadius="{StaticResource RadiusRow}" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" Margin="8,0,4,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small icon button inside a row (rename, remove): 24 square, and in large view its word beside the icon -->
        <Style x:Key="Picker.RowAction" TargetType="Button" BasedOn="{StaticResource Button.IconWordSide}">
            <Setter Property="Width" Value="{StaticResource Space24}" />
            <Setter Property="Height" Value="{StaticResource Space24}" />
            <Style.Triggers>
                <Trigger Property="controls:WidgetCard.IsLarge" Value="True">
                    <Setter Property="Height" Value="{StaticResource Space24}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Closed: the chosen level reads first; the levels above it are smaller context -->
        <Button x:Name="PickerButton" Style="{StaticResource SelectButton}" Click="PickerButton_Click">
            <controls:BreadcrumbPanel x:Name="PathPanel" />
        </Button>

        <!-- Inline error: icon + text, never a colour change alone -->
        <StackPanel x:Name="ErrorLine" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <controls:Icon Kind="Alert" Size="{StaticResource SizeIconSm}" VerticalAlignment="Top" Margin="0,0,4,0" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" Text="Choose an activity to save this entry." />
        </StackPanel>
    </StackPanel>
</UserControl>

