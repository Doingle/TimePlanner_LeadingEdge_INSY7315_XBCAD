<Application x:Class="TimePlanner.Widget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Text.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Fields.xaml" />
                <ResourceDictionary Source="Themes/Options.xaml" />
                <ResourceDictionary Source="Themes/Menus.xaml" />
                <ResourceDictionary Source="Themes/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
            <PopupAnimation x:Key="{x:Static SystemParameters.ComboBoxPopupAnimationKey}">None</PopupAnimation>
        </ResourceDictionary>
    </Application.Resources>
</Application>

