<UserControl x:Class="TimePlanner.Widget.Views.AiAdvancedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    <StackPanel>
        <!-- header -->
        <DockPanel Margin="-8,0,0,0">
            <Button Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Back" ToolTip="Back to Voice and AI" AutomationProperties.Name="Back to Voice and AI" Click="Close_Click">
                <controls:Icon Kind="ChevronLeft" />
            </Button>
            <TextBlock Style="{StaticResource Text.Title}" Text="Advanced" Margin="4,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Margin="0,12,0,0" MaxHeight="450" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- developer setting inactive notice -->
                <TextBlock x:Name="DevSettingInactiveCaption" Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource TextAccentBrush}" Margin="0,0,0,8" Visibility="Collapsed"
                           Text="A developer setting is saved but not active." TextWrapping="Wrap" />

                <!-- HARDWARE -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Hardware" />

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Build my day runs on" />
                    <ComboBox x:Name="DayHardwareSelect" Style="{StaticResource Select}" SelectionChanged="DayHardware_SelectionChanged" />
                    <TextBlock x:Name="DayHardwareCaption" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Button x:Name="SpeedCheckButton" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"
                            Content="Run speed check" ToolTip="Tries the graphics card and the processor, and uses the faster one"
                            AutomationProperties.Name="Run speed check" Click="SpeedCheck_Click" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Voice runs on" />
                    <ComboBox x:Name="VoiceHardwareSelect" Style="{StaticResource Select}" SelectionChanged="VoiceHardware_SelectionChanged" />
                    <TextBlock x:Name="VoiceRestartCaption" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" Text="Applies after Time Planner restarts" Visibility="Collapsed" />
                </StackPanel>

                <Separator Margin="0,16,0,16" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- MICROPHONE -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Microphone" />

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Microphone" />
                    <ComboBox x:Name="MicrophoneSelect" Style="{StaticResource Select}" SelectionChanged="Microphone_SelectionChanged" />
                    <TextBlock x:Name="MicDisconnectedCaption" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextAccentBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="TestMicButton" Style="{StaticResource Button.Secondary}" Content="Test microphone"
                                ToolTip="Test microphone recording level" AutomationProperties.Name="Test microphone recording level"
                                Click="TestMicrophone_Click" />
                        <controls:BarProgress x:Name="MicTestProgress" Height="{StaticResource SizeProgress}" Margin="8,0,0,0"
                                              VerticalAlignment="Center" Visibility="Collapsed" />
                    </DockPanel>
                    <TextBlock x:Name="MicTestResult" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Button x:Name="OpenSoundSettingsButton" Style="{StaticResource Button.Text}" Content="Open sound settings"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed" Click="OpenSoundSettings_Click" />
                </StackPanel>

                <Separator Margin="0,16,0,16" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- AI ENGINE -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="AI engine" />

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="Installs Ollama, a free AI engine, and two models. Ollama runs quietly only while Time Planner is open." />
                    <TextBlock x:Name="EngineManagementText" Style="{StaticResource Text.Body}" Margin="0,6,0,0" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineLocationsText" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OwnOllamaNotice" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Button x:Name="RemoveEngineButton" Style="{StaticResource Button.Text}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Content="Remove AI engine and models" Click="RemoveEngine_Click" />

                    <!-- Inline Confirm -->
                    <Border x:Name="RemoveConfirmPanel" Background="{DynamicResource AccentFillBrush}"
                            CornerRadius="{DynamicResource RadiusBanner}" Padding="12,10" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="This removes Ollama and the downloaded models (about 3 GB). Your timesheets and voice notes stay. Remove?" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="Yes" Click="RemoveConfirmYes_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="No" Click="RemoveConfirmNo_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Separator Margin="0,16,0,16" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- YOUR OWN MODELS -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Your own models" />

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Ollama address" />
                    <TextBox x:Name="OllamaAddressBox" Style="{StaticResource Input}" TextChanged="OllamaAddress_TextChanged" />
                </StackPanel>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Ollama model" />
                    <DockPanel>
                        <Button x:Name="RefreshOllamaModelsButton" DockPanel.Dock="Right" Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Refresh"
                                Margin="8,0,0,0" ToolTip="Refresh the list" AutomationProperties.Name="Refresh the list"
                                Click="RefreshOllamaModels_Click">
                            <controls:Icon Kind="Download" />
                        </Button>
                        <ComboBox x:Name="OllamaModelSelect" Style="{StaticResource Select}" SelectionChanged="OllamaModel_SelectionChanged" />
                    </DockPanel>
                </StackPanel>

                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="TestOllamaButton" Style="{StaticResource Button.Secondary}" Content="Test"
                            ToolTip="Test Ollama connectivity" AutomationProperties.Name="Test Ollama connectivity"
                            Click="TestOllama_Click" />
                    <TextBlock x:Name="OllamaTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Voice model file" />
                    <TextBox x:Name="VoiceModelPathBox" Style="{StaticResource Input}" IsReadOnly="True" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChooseVoiceFileButton" Style="{StaticResource Button.Secondary}" Content="Choose file…"
                                ToolTip="Choose a ggml voice model file" AutomationProperties.Name="Choose a ggml voice model file"
                                Click="ChooseVoiceFile_Click" />
                        <Button x:Name="ClearVoiceFileButton" Style="{StaticResource Button.Text}" Margin="8,0,0,0"
                                Content="Use the built-in model" ToolTip="Use the built-in model"
                                AutomationProperties.Name="Use the built-in model" Click="ClearVoiceFile_Click" />
                    </StackPanel>
                </StackPanel>

                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="TestVoiceButton" Style="{StaticResource Button.Secondary}" Content="Test"
                            ToolTip="Test voice model" AutomationProperties.Name="Test voice model"
                            Click="TestVoice_Click" />
                    <TextBlock x:Name="VoiceTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <Separator Margin="0,16,0,16" Background="{DynamicResource BorderSubtleBrush}" />

                <!-- BUILD MY DAY ENGINE -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Build my day engine" />

                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="EngineThisPcRadio" Content="This PC (Ollama)" Margin="0,4,0,0" Checked="Engine_Checked" />
                    <RadioButton x:Name="EngineOrgAiRadio" Content="Your organisation's AI (dashboard)" Margin="0,8,0,0" Checked="Engine_Checked" />
                    <TextBlock x:Name="OrgAiDisabledReason" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="24,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="OrgAiNotice" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="24,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Your voice notes' text is sent to your organisation's AI service. Audio never leaves this PC." />
                </StackPanel>

                <!-- DEVELOPER DIRECT API (Dev mode only) -->
                <StackPanel x:Name="DevDirectApiPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <Separator Margin="0,0,0,16" Background="{DynamicResource BorderSubtleBrush}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="Developer: direct API service" />

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Transcriber service" />
                        <ComboBox x:Name="DevTranscriberSelect" Style="{StaticResource Select}" SelectionChanged="DevTranscriber_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="DevTranscriberDetailsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Transcriber address" />
                        <TextBox x:Name="DevTranscriberAddressBox" Style="{StaticResource Input}" TextChanged="DevTranscriberAddress_TextChanged" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Transcriber model" Margin="0,8,0,0" />
                        <TextBox x:Name="DevTranscriberModelBox" Style="{StaticResource Input}" TextChanged="DevTranscriberModel_TextChanged" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Transcriber API key" Margin="0,8,0,0" />
                        <PasswordBox x:Name="DevTranscriberApiKeyBox" Height="{StaticResource SizeControl}" Padding="14,0"
                                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}"
                                     VerticalContentAlignment="Center" PasswordChanged="DevTranscriberApiKey_PasswordChanged" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="DevTestTranscriberButton" Style="{StaticResource Button.Secondary}" Content="Test transcriber"
                                Click="DevTestTranscriber_Click" />
                        <TextBlock x:Name="DevTranscriberTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Compiler service" />
                        <ComboBox x:Name="DevCompilerSelect" Style="{StaticResource Select}" SelectionChanged="DevCompiler_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="DevCompilerDetailsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Compiler address" />
                        <TextBox x:Name="DevCompilerAddressBox" Style="{StaticResource Input}" TextChanged="DevCompilerAddress_TextChanged" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Compiler model" Margin="0,8,0,0" />
                        <TextBox x:Name="DevCompilerModelBox" Style="{StaticResource Input}" TextChanged="DevCompilerModel_TextChanged" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Compiler API key" Margin="0,8,0,0" />
                        <PasswordBox x:Name="DevCompilerApiKeyBox" Height="{StaticResource SizeControl}" Padding="14,0"
                                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}"
                                     VerticalContentAlignment="Center" PasswordChanged="DevCompilerApiKey_PasswordChanged" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="DevTestCompilerButton" Style="{StaticResource Button.Secondary}" Content="Test compiler"
                                Click="DevTestCompiler_Click" />
                        <TextBlock x:Name="DevCompilerTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
