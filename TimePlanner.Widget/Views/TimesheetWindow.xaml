<Window x:Class="TimePlanner.Widget.Views.TimesheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
        Title="Timesheet · Time Planner"
        Width="920" Height="560" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderControlBrush}" BorderThickness="{DynamicResource BorderWidth}"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <!-- The purple header is the title bar: drag it to move, double-click it to maximise. The edges resize.
         A one-pixel glass frame, hidden under the window's own background, keeps Windows' shadow around it, and the
         outline gives it an edge, so it stands out from the windows behind it -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Edit and Delete on a row: 32 square, and in large view an outlined "✎ Edit" / "Delete" -->
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource Button.IconWordSide}">
            <Setter Property="Width" Value="{StaticResource Space32}" />
            <Setter Property="Height" Value="{StaticResource Space32}" />
        </Style>

        <!-- Restore on the purple header: outlined in white -->
        <Style x:Key="Button.OnAction" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Space32}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource TextOnActionSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnActionBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActionHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TextOnActionBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActionPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The column titles over the rows -->
        <Style x:Key="ColumnTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,12,0" />
        </Style>
    </Window.Resources>

    <!-- Large view scales this, as the widget's root, so the whole window and its click areas grow together -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title, today's status and Restore -->
        <Border x:Name="Header" Grid.Row="0" Background="{StaticResource ActionBrush}" Height="56" Padding="24,0">
            <DockPanel>
                <Button x:Name="RestoreButton" DockPanel.Dock="Right" Style="{StaticResource Button.OnAction}" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Back to the small timesheet in the widget"
                        AutomationProperties.Name="Back to the small timesheet in the widget" Click="Restore_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="ArrowLeft" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="StatusPill" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite">
                    <Ellipse x:Name="StatusDot" Width="{StaticResource Space8}" Height="{StaticResource Space8}" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{StaticResource TextOnActionSecondaryBrush}" />
                    <TextBlock FontSize="{StaticResource FontSizeCaption}" LineHeight="{StaticResource LineHeightCaption}"
                               LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Foreground="{StaticResource TextOnActionBrush}">
                        <Run x:Name="StatusDate" Text="Tuesday 1 Aug" /><Run Text=" · " /><Run x:Name="StatusState" Text="Day ended"
                                                                                                FontWeight="{StaticResource FontWeightSemibold}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Timesheet" Foreground="{StaticResource TextOnActionBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- The date bar: previous, the day, next, today, the day's total and whether it was sent -->
        <StackPanel Grid.Row="1" Margin="16,16,24,8">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="PrevDayButton" Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Previous" BorderThickness="0"
                        ToolTip="Previous day" AutomationProperties.Name="Previous day" Click="PrevDay_Click">
                    <controls:Icon Kind="ChevronLeft" />
                </Button>
                <Button x:Name="DayButton" Style="{StaticResource Button.Secondary}" Height="{StaticResource Space32}" Padding="12,0" Margin="4,0"
                        VerticalAlignment="Center" Click="DayButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Calendar" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DayText" Text="Tuesday 1 Aug" VerticalAlignment="Center" />
                        <controls:Icon Kind="ChevronDown" Size="{StaticResource SizeIconSm}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NextDayButton" Style="{StaticResource Button.WordIconSide}" controls:WidgetCard.Word="Next" BorderThickness="0"
                        ToolTip="Next day" AutomationProperties.Name="Next day" Click="NextDay_Click">
                    <controls:Icon Kind="ChevronRight" />
                </Button>
                <Button x:Name="TodayButton" Style="{StaticResource Button.Secondary}" Height="{StaticResource Space32}" Padding="16,0" Margin="12,0,0,0"
                        VerticalAlignment="Center" Content="Today" Visibility="Collapsed" AutomationProperties.Name="Go to today" Click="Today_Click" />
                <TextBlock x:Name="TotalText" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSecondaryBrush}" Text="6h 5m"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="SendBadge" Style="{StaticResource Pill.Warning}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon x:Name="BadgeIcon" Kind="Send" Size="{StaticResource SizeIconSm}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BadgeText" Text="Not sent yet" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PastDayHelp" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center" Text="You can still edit this day" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,8,0,0"
                       Visibility="Collapsed" />
            <Grid x:Name="UndoBar" Visibility="Collapsed" Margin="8,8,0,0" HorizontalAlignment="Left">
                <Border Background="{StaticResource ActionBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UndoText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextOnActionBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Text}" Content="Undo" Foreground="{StaticResource TextOnActionBrush}" FontWeight="Bold"
                                Margin="12,0,0,0" Click="Undo_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- The rows: the table scrolls, and when the window is narrow the Note column gives up its room first -->
        <ScrollViewer x:Name="TableScroller" Grid.Row="2" Margin="24,0,24,0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Table" Grid.IsSharedSizeScope="True">
                <Grid x:Name="ColumnTitles" Height="{StaticResource SizeControl}" />
                <Border Height="2" Background="{StaticResource BorderSubtleBrush}" />
                <StackPanel x:Name="Rows" />
            </StackPanel>
        </ScrollViewer>

        <!-- Always in view under the rows -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Padding="20,0" Content="Send day" Click="Send_Click" />
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource Button.Text}" Content="Export CSV" Margin="0,0,12,0"
                        VerticalAlignment="Center" Click="Export_Click" />
                <Button x:Name="AddTimeButton" Style="{StaticResource Button.Secondary}" Padding="12,0" HorizontalAlignment="Left"
                        AutomationProperties.Name="Add time" Click="AddTime_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Plus" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add time" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
