<UserControl x:Class="TimePlanner.Widget.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    
    <Grid x:Name="Root" Background="Transparent" Cursor="Hand" MouseEnter="Root_MouseEnter"
          HorizontalAlignment="Right" VerticalAlignment="Bottom">

        <!-- Pill: clock + time left, label type with tabular figures -->
        <Grid x:Name="Pill" AutomationProperties.Name="1 hour 12 minutes until your next check-in">
            <Border CornerRadius="{StaticResource RadiusPill}" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowMenu}" />
            <Border Height="{StaticResource SizeControl}" Padding="16,0" CornerRadius="{StaticResource RadiusPill}"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="{DynamicResource BorderWidth}" RenderOptions.ClearTypeHint="Enabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
                    <controls:Icon Kind="Clock" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillTime" Text="01:12" VerticalAlignment="Center" FontWeight="{StaticResource FontWeightSemibold}"
                               LineHeight="{StaticResource LineHeightBody}" LineStackingStrategy="BlockLineHeight"
                               Typography.NumeralAlignment="Tabular" RenderTransform="{StaticResource Baseline.Body}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ring: fills as the time runs out -->
        <Grid x:Name="Ring" Visibility="Collapsed" AutomationProperties.Name="Next check-in in 1 hour 12 minutes">
            <Border CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowMenu}" />
            <Border Width="{StaticResource SizeControl}" Height="{StaticResource SizeControl}" CornerRadius="{StaticResource RadiusFull}"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="{DynamicResource BorderWidth}">
                <controls:RingProgress x:Name="RingProgress" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TrackBrush="{StaticResource DataTrackBrush}" FillBrush="{StaticResource DataBrush}" />
            </Border>
        </Grid>

        <!-- Dot: just says the widget is tracking; hover to see the time -->
        <Grid x:Name="Dot" Visibility="Collapsed" AutomationProperties.Name="INSY is tracking">
            <Border CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowMenu}" />
            <Border Width="{StaticResource Space16}" Height="{StaticResource Space16}" CornerRadius="{StaticResource RadiusFull}"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                    BorderThickness="{DynamicResource BorderWidth}">
                <Ellipse Width="{StaticResource Space8}" Height="{StaticResource Space8}" Fill="{StaticResource DataBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
