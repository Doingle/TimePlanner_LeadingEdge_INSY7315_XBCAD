<UserControl x:Class="TimePlanner.Widget.Views.TimesheetReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    
    <controls:WidgetCard AutomationProperties.Name="Timesheet">
        <StackPanel>
            <DockPanel Margin="-8,0,0,0">
                <Button Style="{StaticResource Button.Icon}" ToolTip="Back" AutomationProperties.Name="Back to Day ended"
                        Click="Back_Click">
                    <controls:Icon Kind="ChevronLeft" />
                </Button>
                <TextBlock Style="{StaticResource Text.Title}" Text="Timesheet" Margin="4,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Text.Subtitle}" Text="Tuesday, Aug 1 · 6h 5m" />

            <ScrollViewer x:Name="EntryScroller" Margin="{StaticResource GapSection}" MaxHeight="336"
                          VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="EntryList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Stat}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Body}" Text="{Binding Length}" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Time}" FontWeight="{StaticResource FontWeightSemibold}"
                                                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Activity}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Activity}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Project}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Note}" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding NoteVisibility}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <TextBlock x:Name="EmptyHelp" Style="{StaticResource Text.Help}" Visibility="Collapsed"
                       Text="Nothing was logged on this day." />

            <Button x:Name="ExportButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource GapSection}"
                    AutomationProperties.Name="Export CSV" Click="Export_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="Download" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </controls:WidgetCard>
</UserControl>
