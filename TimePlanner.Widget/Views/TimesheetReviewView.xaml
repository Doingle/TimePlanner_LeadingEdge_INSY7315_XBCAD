<UserControl x:Class="TimePlanner.Widget.Views.TimesheetReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    
    <controls:WidgetCard AutomationProperties.Name="Timesheet">
        <StackPanel>
            <DockPanel Margin="-8,0,0,0">
                <Button Style="{StaticResource Button.Icon}" ToolTip="Back" AutomationProperties.Name="Back"
                        Click="Back_Click">
                    <controls:Icon Kind="ChevronLeft" />
                </Button>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <!-- Back to today from an earlier day -->
                    <Button x:Name="TodayButton" Style="{StaticResource Button.Secondary}" Height="{StaticResource Space32}" Padding="12,0"
                            Margin="0,0,4,0" Content="Today" Visibility="Collapsed" AutomationProperties.Name="Go to today"
                            Click="Today_Click" />
                    <Button x:Name="PrevDayButton" Style="{StaticResource Button.Icon}" ToolTip="Previous day"
                            AutomationProperties.Name="Previous day" Click="PrevDay_Click">
                        <controls:Icon Kind="ChevronLeft" />
                    </Button>
                    <Button x:Name="NextDayButton" Style="{StaticResource Button.Icon}" ToolTip="Next day"
                            AutomationProperties.Name="Next day" Click="NextDay_Click">
                        <controls:Icon Kind="ChevronRight" />
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Timesheet" Margin="4,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <Grid x:Name="UndoBar" Visibility="Collapsed" Margin="0,4,0,0">
                <Border Background="{StaticResource ActionBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="8,4">
                    <DockPanel>
                        <Button Style="{StaticResource Button.Text}" Content="Undo" Foreground="{StaticResource TextOnActionBrush}" FontWeight="Bold"
                                DockPanel.Dock="Right" Click="Undo_Click" />
                        <TextBlock x:Name="UndoText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextOnActionBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- The day shown, as a picker over the last two weeks with what was logged and sent on each -->
            <Button x:Name="DayButton" Style="{StaticResource SelectButton}" Margin="0,12,0,0" Click="DayButton_Click">
                <TextBlock x:Name="Subtitle" Text="Tuesday 1 Aug · 6h 5m" TextTrimming="CharacterEllipsis" />
            </Button>
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
            <TextBlock x:Name="PastDayHelp" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,2,0,0" Text="You can still edit this day." Visibility="Collapsed" />
            <StackPanel x:Name="AccountRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,0">
                <TextBlock x:Name="AccountText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="SignOutButton" Style="{StaticResource Button.Text}" Content="Sign out" Margin="4,0,0,0" Click="SignOut_Click" />
            </StackPanel>

            <Border x:Name="UnbuiltBanner" Background="{StaticResource AccentFillBrush}" CornerRadius="{StaticResource RadiusBanner}"
                    Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="BuildDayButton" Style="{StaticResource Button.Primary}" Content="Build my day"
                            DockPanel.Dock="Right" Margin="8,0,0,0" Click="BuildDay_Click" />
                    <TextBlock x:Name="UnbuiltBannerText" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="EntryScroller" Margin="{StaticResource GapSection}" MaxHeight="300"
                          VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="SlotContainer" />
            </ScrollViewer>

            <Button x:Name="AddTimeButton" Style="{StaticResource Button.Text}" Content="+ Add time"
                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="AddTime_Click" />

            <StackPanel Margin="{StaticResource GapSection}">
                <Button x:Name="SendButton" Style="{StaticResource Button.Primary}" Content="Send day" Click="Send_Click" />
                <Button x:Name="ExportButton" Style="{StaticResource Button.Text}" Content="Export CSV" Margin="0,4,0,0" Click="Export_Click" />
            </StackPanel>
        </StackPanel>
    </controls:WidgetCard>
</UserControl>
