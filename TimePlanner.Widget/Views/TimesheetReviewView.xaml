<UserControl x:Class="TimePlanner.Widget.Views.TimesheetReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    <UserControl.Resources>
        <!-- One logged entry: a white card, with its Edit and Delete under it -->
        <Style x:Key="EntryCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Edit and Delete on an entry: 32 square, and in large view an outlined "✎ Edit" / "Delete", 4 apart -->
        <Style x:Key="EntryAction" TargetType="Button" BasedOn="{StaticResource Button.IconWordSide}">
            <Setter Property="Width" Value="{StaticResource Space32}" />
            <Setter Property="Height" Value="{StaticResource Space32}" />
            <Style.Triggers>
                <Trigger Property="controls:WidgetCard.IsLarge" Value="True">
                    <Setter Property="Margin" Value="4,0,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Edit and Delete together: at the end of the entry's top row, taking no more height than its text; in large view
             under the entry on the right, where their words fit -->
        <Style x:Key="EntryActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,-6,-8,-6" />
            <Style.Triggers>
                <Trigger Property="controls:WidgetCard.IsLarge" Value="True">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The day in the day bar: fills the room between Previous and Next, its content centred. In large view, where
             Previous and Next show their words, it keeps a little less room either side so the day shows in full -->
        <Style x:Key="DayBarDay" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="controls:WidgetCard.IsLarge" Value="True">
                    <Setter Property="Padding" Value="8,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <controls:WidgetCard AutomationProperties.Name="Timesheet">
        <StackPanel>
            <!-- Back, the title, and Expand to the wide window: an icon, and in large view "Expand" beside it without an outline -->
            <DockPanel Margin="-8,0,-8,0">
                <Button Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Back" ToolTip="Back" AutomationProperties.Name="Back"
                        Click="Back_Click">
                    <controls:Icon Kind="ChevronLeft" />
                </Button>
                <Button x:Name="MaximiseButton" DockPanel.Dock="Right" Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Expand"
                        BorderThickness="0" ToolTip="Open the timesheet in a wide window"
                        AutomationProperties.Name="Expand: open the timesheet in a wide window" Click="Maximise_Click">
                    <controls:Icon Kind="Maximise" />
                </Button>
                <TextBlock Style="{StaticResource Text.Title}" Text="Timesheet" Margin="4,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <Grid x:Name="UndoBar" Visibility="Collapsed" Margin="0,4,0,0">
                <Border Background="{StaticResource ActionBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="8,4">
                    <DockPanel>
                        <Button Style="{StaticResource Button.Text}" Content="Undo" Foreground="{StaticResource TextOnActionBrush}" FontWeight="Bold"
                                DockPanel.Dock="Right" Click="Undo_Click" />
                        <TextBlock x:Name="UndoText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextOnActionBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- The day bar: previous and next either side of the day's button, which lists the last two weeks with what was logged
                 and sent. One outlined bar the width of the card, split by hairlines; the buttons fill it and have no outline of their own -->
            <Border Margin="0,12,0,0" Height="{StaticResource SizeControl}" BorderBrush="{StaticResource BorderControlBrush}"
                    BorderThickness="{DynamicResource BorderWidth}" CornerRadius="{StaticResource RadiusControl}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrevDayButton" Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Previous" Height="NaN"
                            BorderThickness="0" ToolTip="Previous day" AutomationProperties.Name="Previous day" Click="PrevDay_Click">
                        <controls:Icon Kind="ChevronLeft" Size="{StaticResource SizeIconSm}" />
                    </Button>
                    <Border Grid.Column="1" Width="{DynamicResource Hairline}" Background="{StaticResource BorderControlBrush}" />
                    <Button x:Name="DayButton" Grid.Column="2" Style="{StaticResource DayBarDay}" Click="DayButton_Click">
                        <DockPanel>
                            <controls:Icon Kind="Calendar" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <controls:Icon DockPanel.Dock="Right" Kind="ChevronDown" Size="{StaticResource SizeIconSm}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="DayText" Text="Tue 1 Aug" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Border Grid.Column="3" Width="{DynamicResource Hairline}" Background="{StaticResource BorderControlBrush}" />
                    <Button x:Name="NextDayButton" Grid.Column="4" Style="{StaticResource Button.WordIconSide}" controls:WidgetCard.Word="Next" Height="NaN"
                            BorderThickness="0" ToolTip="Next day" AutomationProperties.Name="Next day" Click="NextDay_Click">
                        <controls:Icon Kind="ChevronRight" Size="{StaticResource SizeIconSm}" />
                    </Button>
                </Grid>
            </Border>

            <!-- The day's total, whether it went to the dashboard, and the way back to today from an earlier day -->
            <DockPanel Margin="0,12,0,0">
                <Button x:Name="TodayButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="{StaticResource Space32}" Padding="16,0"
                        VerticalAlignment="Center" Content="Today" Visibility="Collapsed" AutomationProperties.Name="Go to today" Click="Today_Click" />
                <TextBlock x:Name="TotalText" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSecondaryBrush}" Text="6h 5m"
                           VerticalAlignment="Center" />
                <Border x:Name="SendBadge" Style="{StaticResource Pill.Warning}" Margin="8,0,8,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon x:Name="BadgeIcon" Kind="Send" Size="{StaticResource SizeIconSm}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BadgeText" Text="Not sent yet" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DockPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="PastDayHelp" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,8,0,0" Text="You can still edit this day." Visibility="Collapsed" />
            <StackPanel x:Name="AccountRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,0">
                <TextBlock x:Name="AccountText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="SignOutButton" Style="{StaticResource Button.Text}" Content="Sign out" Margin="4,0,0,0" Click="SignOut_Click" />
            </StackPanel>

            <Border x:Name="UnbuiltBanner" Background="{StaticResource AccentFillBrush}" CornerRadius="{StaticResource RadiusBanner}"
                    Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="BuildDayButton" Style="{StaticResource Button.Primary}" Content="Build my day"
                            DockPanel.Dock="Right" Margin="8,0,0,0" Click="BuildDay_Click" />
                    <TextBlock x:Name="UnbuiltBannerText" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- The entries scroll; what comes after them stays in view -->
            <ScrollViewer x:Name="EntryScroller" Margin="0,12,0,0" MaxHeight="300"
                          VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="SlotContainer" />
            </ScrollViewer>

            <Border Height="{DynamicResource Hairline}" Background="{StaticResource BorderSubtleBrush}" Margin="-16,4,-16,0" />
            <Button x:Name="AddTimeButton" Style="{StaticResource Button.Icon}" Width="NaN" Padding="8,0" HorizontalAlignment="Left"
                    Margin="-8,8,0,0" Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.Name="Add time" Click="AddTime_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Kind="Plus" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add time" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Margin="0,8,0,0">
                <Button x:Name="SendButton" Style="{StaticResource Button.Primary}" Content="Send day" Click="Send_Click" />
                <Button x:Name="ExportButton" Style="{StaticResource Button.Text}" Content="Export CSV" Margin="0,4,0,0" Click="Export_Click" />
            </StackPanel>
        </StackPanel>
    </controls:WidgetCard>
</UserControl>
