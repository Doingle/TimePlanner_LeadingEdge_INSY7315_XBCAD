<UserControl x:Class="TimePlanner.Widget.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
             xmlns:views="clr-namespace:TimePlanner.Widget.Views">
    <controls:WidgetCard AutomationProperties.Name="Voice and AI settings">
        <Grid>
            <!-- ========================= MAIN VIEW ========================= -->
            <StackPanel x:Name="MainView">
                <!-- header -->
                <DockPanel Margin="-8,0,0,0">
                    <Button Style="{StaticResource Button.Icon}" ToolTip="Back to Settings" AutomationProperties.Name="Back to Settings" Click="Back_Click">
                        <controls:Icon Kind="ChevronLeft" />
                    </Button>
                    <Border x:Name="DevBadge" DockPanel.Dock="Right" Background="{DynamicResource ActionBrush}"
                            CornerRadius="{DynamicResource RadiusFull}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Dev" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextOnActionBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Voice and AI" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <!-- setup card -->
                <views:AiSetupCard x:Name="SetupCard" Margin="0,12,0,0" />

                <!-- voice notes at check-ins -->
                <DockPanel Margin="0,12,0,0" MinHeight="{StaticResource SizeControl}">
                    <ToggleButton x:Name="VoiceEnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                  Checked="VoiceEnabled_Changed" Unchecked="VoiceEnabled_Changed" />
                    <TextBlock Text="Voice notes at check-ins" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- build my day model -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Build my day model" />
                    <DockPanel>
                        <Button x:Name="DayModelDownloadButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="DayModelDownload_Click" />
                        <ComboBox x:Name="DayModelSelect" Style="{StaticResource Select}" SelectionChanged="DayModel_SelectionChanged" />
                    </DockPanel>
                    <controls:BarProgress x:Name="DayModelProgressBar" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- voice accuracy -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Voice accuracy" />
                    <DockPanel>
                        <Button x:Name="VoiceModelDownloadButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="VoiceModelDownload_Click" />
                        <ComboBox x:Name="VoiceModelSelect" Style="{StaticResource Select}" SelectionChanged="VoiceModel_SelectionChanged" />
                    </DockPanel>
                    <controls:BarProgress x:Name="VoiceModelProgressBar" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- advanced nav row -->
                <Button x:Name="AdvancedRow" Style="{StaticResource NavRow}" Margin="{StaticResource GapFieldToField}" Click="OpenAdvanced_Click">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="AdvancedSummary" Text="Automatic · This PC" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <controls:Icon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Advanced" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- notice banner -->
                <Border Background="{DynamicResource AccentFillBrush}" CornerRadius="{DynamicResource RadiusBanner}"
                        Padding="10,6" Margin="{StaticResource GapFieldToField}">
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="AI can make mistakes. Always check your day before sending it." />
                </Border>

                <!-- done button -->
                <Button Style="{StaticResource Button.Primary}" Margin="{StaticResource GapSection}"
                        Content="Done" Click="Back_Click" />
            </StackPanel>

            <!-- ========================= ADVANCED VIEW ========================= -->
            <views:AiAdvancedPanel x:Name="AdvancedPanel" Visibility="Collapsed" />
        </Grid>
    </controls:WidgetCard>
</UserControl>
