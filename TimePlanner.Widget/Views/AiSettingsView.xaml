<UserControl x:Class="TimePlanner.Widget.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    <controls:WidgetCard AutomationProperties.Name="Voice and AI settings">
        <StackPanel>
            <DockPanel Margin="-8,0,0,0">
                <Button Style="{StaticResource Button.Icon}" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click">
                    <controls:Icon Kind="ChevronLeft" />
                </Button>
                <TextBlock Style="{StaticResource Text.Title}" Text="Voice and AI" Margin="4,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Margin="{StaticResource GapSection}" MaxHeight="450" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Border x:Name="StatusBanner" Background="{StaticResource AccentFillBrush}" CornerRadius="{StaticResource RadiusBanner}"
                            Padding="12,8" Margin="0,0,0,12">
                        <TextBlock x:Name="StatusBannerText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="Voice notes" />

                    <DockPanel Margin="0,8,0,0" MinHeight="{StaticResource SizeControl}">
                        <ToggleButton x:Name="VoiceEnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                      Checked="VoiceEnabled_Changed" Unchecked="VoiceEnabled_Changed" />
                        <TextBlock Text="Enable voice notes" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel x:Name="VoiceModelPanel" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Voice model" />
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button x:Name="DownloadModelButton" Style="{StaticResource Button.Secondary}"
                                        Click="DownloadModel_Click" />
                                <Button x:Name="ImportModelButton" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                        Content="Use a file I have" Click="ImportModel_Click" />
                            </StackPanel>
                            <ComboBox x:Name="VoiceModelSelect" Style="{StaticResource Select}" SelectionChanged="VoiceModel_SelectionChanged" />
                        </DockPanel>
                        <TextBlock x:Name="DownloadProgressText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Transcriber" />
                        <ComboBox x:Name="TranscriberSelect" Style="{StaticResource Select}" SelectionChanged="Transcriber_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="OtherTranscriberPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Service address" />
                        <TextBox x:Name="TranscriberAddressBox" Style="{StaticResource Input}" TextChanged="TranscriberAddress_TextChanged" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Model" Margin="0,8,0,0" />
                        <TextBox x:Name="TranscriberModelBox" Style="{StaticResource Input}" TextChanged="TranscriberModel_TextChanged" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="API key" Margin="0,8,0,0" />
                        <PasswordBox x:Name="TranscriberApiKeyBox" Height="{StaticResource SizeControl}" Padding="14,0"
                                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}"
                                     VerticalContentAlignment="Center" PasswordChanged="TranscriberApiKey_PasswordChanged" />
                        <TextBlock x:Name="TranscriberKeySavedHint" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Text="A key is saved. Type a new one to replace it." Visibility="Collapsed" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="TestTranscriberButton" Style="{StaticResource Button.Secondary}" Content="Test" Click="TestTranscriber_Click" />
                        <TextBlock x:Name="TranscriberTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <Separator Margin="0,16,0,16" Background="{StaticResource BorderSubtleBrush}" />

                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="Build my day" />

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Engine" />
                        <ComboBox x:Name="CompilerEngineSelect" Style="{StaticResource Select}" SelectionChanged="CompilerEngine_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Address" />
                        <TextBox x:Name="CompilerAddressBox" Style="{StaticResource Input}" TextChanged="CompilerAddress_TextChanged" />
                    </StackPanel>

                    <StackPanel x:Name="OllamaSetupPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="OllamaNotRunningPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Text.Help}" TextWrapping="Wrap"
                                       Text="Ollama isn't running. Install it, or start it from the Start menu." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Content="Get Ollama" Click="GetOllama_Click" />
                                <Button x:Name="CheckAgainButton" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                        Content="Check again" Click="CheckAgain_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="OllamaModelMissingPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Text.Help}" TextWrapping="Wrap"
                                       Text="The day model isn't downloaded yet (about 2 GB)." />
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="DownloadDayModelButton" Style="{StaticResource Button.Primary}" Content="Download model"
                                        Click="DownloadDayModel_Click" />
                                <TextBlock x:Name="DayModelDownloadText" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="OllamaModelPanel" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Model" />
                        <DockPanel>
                            <Button x:Name="RefreshModelsButton" Style="{StaticResource Button.Secondary}" Content="Refresh" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Click="RefreshModels_Click" />
                            <ComboBox x:Name="OllamaModelSelect" Style="{StaticResource Select}" SelectionChanged="OllamaModel_SelectionChanged" />
                        </DockPanel>
                        <TextBlock x:Name="OllamaHelpText" Style="{StaticResource Text.Help}" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="OtherCompilerPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Model" />
                        <TextBox x:Name="OtherCompilerModelBox" Style="{StaticResource Input}" TextChanged="OtherCompilerModel_TextChanged" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="API key" Margin="0,8,0,0" />
                        <PasswordBox x:Name="CompilerApiKeyBox" Height="{StaticResource SizeControl}" Padding="14,0"
                                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}"
                                     VerticalContentAlignment="Center" PasswordChanged="CompilerApiKey_PasswordChanged" />
                        <TextBlock x:Name="CompilerKeySavedHint" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Text="A key is saved. Type a new one to replace it." Visibility="Collapsed" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="TestCompilerButton" Style="{StaticResource Button.Secondary}" Content="Test" Click="TestCompiler_Click" />
                        <TextBlock x:Name="CompilerTestResult" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <Border Background="{StaticResource AccentFillBrush}" CornerRadius="{StaticResource RadiusBanner}"
                            Padding="12,8" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Voice notes and the day builder run on this PC unless you choose another service. AI can make mistakes. Always check your day before sending it." />
                    </Border>

                    <Button Style="{StaticResource Button.Primary}" Content="Done" Margin="{StaticResource GapSection}" Click="Done_Click" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </controls:WidgetCard>
</UserControl>
