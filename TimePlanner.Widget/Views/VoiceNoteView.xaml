<UserControl x:Class="TimePlanner.Widget.Views.VoiceNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    <controls:WidgetCard IsRaised="True" Padding="{StaticResource ShellPaddingWithFoot}"
                         AutomationProperties.Name="Voice notes">
        <StackPanel>
            <!-- Consent State -->
            <StackPanel x:Name="ConsentState" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource Badge}" Margin="0,0,16,0">
                        <controls:Icon Kind="Mic" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Title}" Text="Voice notes" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Say what you worked on and Time Planner turns it into timesheet entries at the end of the day. Your voice and notes stay on this PC. AI can make mistakes, so you'll always check the day before sending it." />
                <StackPanel Margin="{StaticResource GapSection}">
                    <Button Style="{StaticResource Button.Primary}" Content="Turn on voice notes" Click="TurnOn_Click" />
                    <Button Style="{StaticResource Button.Text}" Content="Not now" Click="Cancel_Click" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Model Needed State -->
            <StackPanel x:Name="ModelNeededState" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource Badge}" Margin="0,0,16,0">
                        <controls:Icon Kind="Download" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Title}" Text="Download voice model" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Voice notes need a one-time download (about 190 MB)." />
                <StackPanel Margin="{StaticResource GapSection}">
                    <ProgressBar x:Name="DownloadBar" Height="6" Margin="0,0,0,8" Visibility="Collapsed" />
                    <TextBlock x:Name="DownloadPctText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" />
                    <TextBlock x:Name="ModelDownloadErrorText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                    <Button x:Name="DownloadButton" Style="{StaticResource Button.Primary}" Content="Download" Click="Download_Click" />
                    <Button Style="{StaticResource Button.Text}" Content="Cancel" Click="CancelDownload_Click" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Ready / Recording State -->
            <StackPanel x:Name="RecordingState" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="WindowHeaderText" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Recording Controls and Visuals -->
                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,8">
                    <Button x:Name="RecordButton" Width="56" Height="56" Click="RecordButton_Click" HorizontalAlignment="Center"
                            Style="{StaticResource Button.Primary}">
                        <controls:Icon x:Name="RecordIcon" Kind="Mic" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Active Recording Status -->
                <StackPanel x:Name="ActiveRecordingIndicator" Visibility="Collapsed" Margin="0,4,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Ellipse x:Name="PulsingDot" Width="8" Height="8" Fill="{StaticResource ActionBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimerText" Style="{StaticResource Text.Timer}" Text="0:00" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="LevelTrack" Background="{StaticResource DataTrackBrush}" Height="6" CornerRadius="3" ClipToBounds="True" Margin="0,4,0,4">
                        <Border x:Name="LevelBar" Background="{StaticResource DataBrush}" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                    </Border>
                </StackPanel>

                <!-- Caption / Remaining time -->
                <TextBlock x:Name="CaptionText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12"
                           Text="Speak naturally. Mention the client, what you did, any problem and how you fixed it." />

                <!-- Error Display -->
                <StackPanel x:Name="ErrorSection" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Type instead" Click="TypeInstead_Click" />
                </StackPanel>

                <!-- Bottom Cancel Row -->
                <Button Style="{StaticResource Button.Text}" Content="Cancel" Click="Cancel_Click" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Saved State -->
            <StackPanel x:Name="SavedState" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource Badge}" Margin="0,0,16,0">
                        <controls:Icon Kind="Check" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SavedTitleText" Style="{StaticResource Text.Title}" Text="Saved" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="SavedMessageText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Saved. Transcribing in the background." />
                <TextBlock x:Name="SavedErrorText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                <StackPanel Margin="{StaticResource GapSection}">
                    <Button x:Name="DoneButton" Style="{StaticResource Button.Primary}" Content="Done" Click="Done_Click" />
                    <StackPanel x:Name="NoSpeechButtons" Visibility="Collapsed">
                        <Button Style="{StaticResource Button.Primary}" Content="Record again" Click="RecordAgain_Click" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Keep it" Click="Done_Click" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </controls:WidgetCard>
</UserControl>
