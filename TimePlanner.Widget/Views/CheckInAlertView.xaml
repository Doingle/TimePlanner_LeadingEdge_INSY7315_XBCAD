<UserControl x:Class="TimePlanner.Widget.Views.CheckInAlertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">
    <UserControl.Resources>
        <!-- The voice tip band's button: fills the band, accent words, no outline -->
        <Style x:Key="CheckIn.TipBand" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="{StaticResource SizeControl}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextAccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <controls:WidgetCard IsRaised="True" Padding="{StaticResource ShellPaddingWithFoot}"
                         AutomationProperties.Name="Time to check in">
        <StackPanel>
            <DockPanel>
                <Border Style="{StaticResource Badge}" Margin="0,0,16,0">
                    <controls:Icon Kind="Bell" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Time to check in" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Subtitle}" Text="Log what you did since 3:05 PM." />
                </StackPanel>
            </DockPanel>

            <StackPanel Margin="{StaticResource GapSection}">
                <Button Style="{StaticResource Button.Primary}" Content="Log time" Click="LogTime_Click" />
                <!-- One click: the period goes to the last entry's project and activity, named under the label -->
                <Button x:Name="SameTaskButton" Style="{StaticResource Button.Secondary}" Height="Auto" Padding="16,8"
                        Margin="{StaticResource GapStacked}" Visibility="Collapsed" Click="SameTask_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Still on the same task" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SameTaskText" Style="{StaticResource Text.Caption}" FontWeight="{StaticResource FontWeightRegular}"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button x:Name="SpeakUpdateButton" Style="{StaticResource Button.Secondary}" Click="SpeakUpdate_Click" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <controls:Icon Kind="Mic" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Speak your update" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid Style="{StaticResource FootRow}">
                    <Button x:Name="SnoozeButton" Style="{StaticResource Button.Text}" Content="Snooze 10m (3 left)" Click="Snooze_Click" />
                    <StackPanel x:Name="NoSnoozes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                        <controls:Icon Kind="Lock" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="No snoozes left" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- first-use tip: a band across the foot of the card, edge to edge; the whole band opens Voice and AI -->
                <Border x:Name="FirstUseTipPanel" Margin="-16,8,-16,-8" Visibility="Collapsed"
                        Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="{StaticResource RadiusShellFoot}">
                    <Button x:Name="TipLinkButton" Style="{StaticResource CheckIn.TipBand}"
                            ToolTip="Set up voice notes in Voice and AI" AutomationProperties.Name="New: speak your update instead. Set it up"
                            Click="TipLink_Click">
                        <DockPanel>
                            <controls:Icon Kind="Mic" Size="{StaticResource SizeIcon}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <controls:Icon Kind="ChevronRight" DockPanel.Dock="Right" Size="{StaticResource SizeIconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="New: speak your update instead" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Hides the voice tip for good: an ✕ in the corner, "✕ Close" in large view -->
        <controls:WidgetCard.CornerContent>
            <Button x:Name="DismissTipButton" Style="{StaticResource Button.IconWordSide}" controls:WidgetCard.Word="Close"
                    ToolTip="Don't show the voice tip again" AutomationProperties.Name="Don't show the voice tip again"
                    Visibility="Collapsed" Click="DismissTip_Click">
                <controls:Icon Kind="Close" />
            </Button>
        </controls:WidgetCard.CornerContent>
    </controls:WidgetCard>
</UserControl>
