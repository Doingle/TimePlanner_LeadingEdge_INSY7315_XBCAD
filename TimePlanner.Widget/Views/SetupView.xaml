<UserControl x:Class="TimePlanner.Widget.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
             xmlns:views="clr-namespace:TimePlanner.Widget.Views">
    <UserControl.Resources>
        <!-- A plain list row that opens another screen: no outline, the row is the button -->
        <Style x:Key="PlainRow" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The close rows of More options sit 4 apart -->
        <Thickness x:Key="Space4Top">0,4,0,0</Thickness>

        <!-- A tick box: filled in the action colour with a white tick while ticked, then its label -->
        <Style x:Key="TickBox" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{StaticResource SizeControl}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusRow}" Padding="8,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="{StaticResource SizeIcon}" Height="{StaticResource SizeIcon}" VerticalAlignment="Center">
                                    <Border x:Name="Box" CornerRadius="{StaticResource RadiusRow}" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderControlBrush}" BorderThickness="{DynamicResource BorderWidthSelected}" />
                                    <controls:Icon x:Name="Tick" Kind="Check" Size="{StaticResource SizeIconSm}" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextOnActionBrush}" />
                                </Grid>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource ActionBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One interval: its name, and a tick on the right while chosen -->
        <Style x:Key="IntervalItem" TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{StaticResource SizeControl}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusRow}" Padding="{TemplateBinding Padding}">
                            <DockPanel VerticalAlignment="Center">
                                <controls:Icon x:Name="Tick" Kind="Check" Size="{StaticResource SizeIconSm}" Visibility="Hidden"
                                               DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextAccentBrush}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check in every: the theme's select, with whatever is in Tag (the half-hour tick box) above the intervals -->
        <Style x:Key="IntervalSelect" TargetType="ComboBox" BasedOn="{StaticResource Select}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource IntervalItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}" />
                            <Border x:Name="Ring" Visibility="Collapsed" CornerRadius="{StaticResource RadiusControl}"
                                    UseLayoutRounding="False" BorderThickness="{DynamicResource BorderWidthSelected}" BorderBrush="{StaticResource BorderSelectedBrush}" />
                            <ContentPresenter x:Name="ContentSite" Margin="17,0,45,0" IsHitTestVisible="False"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <controls:Icon x:Name="Chevron" Kind="ChevronDown" Size="{StaticResource SizeIcon}" Margin="0,0,17,0" IsHitTestVisible="False"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                           RenderTransformOrigin="0.5,0.5" />
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding ElementName=Root}" controls:PopupPlacement.Kind="Dropdown">
                                <Grid Margin="{x:Static controls:PopupPlacement.ShadowMargin}" Width="{Binding ActualWidth, ElementName=Root}"
                                      TextElement.FontWeight="{StaticResource FontWeightRegular}">
                                    <Border Style="{StaticResource Menu.Shadow}" />
                                    <Border Style="{StaticResource Menu.Panel}">
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Tag}" />
                                            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSelectedBrush}" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <controls:WidgetCard x:Name="Card">
        <controls:WidgetCard.Banner>
            <!-- Covers the card's 1px outline on the top and sides, so no light edge shows around the colour -->
            <Border x:Name="WelcomeBanner" Background="{StaticResource ActionBrush}" CornerRadius="{StaticResource RadiusBanner}"
                    Margin="-1,-1,-1,0" Padding="16">
                <StackPanel>
                    <Border Width="{StaticResource SizeBadge}" Height="{StaticResource SizeBadge}" CornerRadius="{StaticResource RadiusFull}"
                            Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center">
                        <Border Width="{StaticResource SizeIcon}" Height="{StaticResource SizeIcon}" CornerRadius="{StaticResource RadiusMark}"
                                Background="{StaticResource ActionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:Icon Kind="ClockHands" Foreground="{StaticResource TextOnActionBrush}" />
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Welcome to Time Planner" Margin="0,8,0,0" TextAlignment="Center"
                               Foreground="{StaticResource TextOnActionBrush}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="Runs until you end your day." TextAlignment="Center"
                               Foreground="{StaticResource TextOnActionSecondaryBrush}" />

                    <!-- Today's date and state in a soft pill, standing in for the card's own status line on this screen -->
                    <Grid x:Name="BannerStatus" HorizontalAlignment="Center" Margin="0,12,0,0"
                          DataContext="{Binding Path=(controls:WidgetCard.Status), RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AutomationProperties.Name="{Binding Spoken}">
                        <Border CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource TextOnActionBrush}" Opacity="0.18" />
                        <StackPanel Orientation="Horizontal" Margin="10,4,12,4">
                            <Ellipse Width="{StaticResource Space8}" Height="{StaticResource Space8}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextOnActionSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Live}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="{StaticResource FontSizeCaption}" LineHeight="{StaticResource LineHeightCaption}"
                                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Foreground="{StaticResource TextOnActionBrush}">
                                <Run Text="{Binding Date, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}"
                                                                                                  FontWeight="{StaticResource FontWeightSemibold}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </controls:WidgetCard.Banner>

        <Grid>
            <StackPanel x:Name="MainView">
                <DockPanel x:Name="SettingsHeader" Margin="-8,0,0,0" Visibility="Collapsed">
                    <Button x:Name="SettingsHelpButton" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                            Height="{StaticResource Space32}" Padding="12,0" VerticalAlignment="Center"
                            ToolTip="Help" AutomationProperties.Name="Help" Click="Help_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Info" Size="{StaticResource SizeIconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="Help" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" ToolTip="Back" AutomationProperties.Name="Back to the timer"
                            Click="BackToTimer_Click">
                        <controls:Icon Kind="ChevronLeft" />
                    </Button>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Settings" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel x:Name="TimingSection">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Check-in timing" />
                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="4">
                        <UniformGrid x:Name="TimingOptions" Columns="2">
                            <UniformGrid.Resources>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource Option}">
                                    <Setter Property="Height" Value="{StaticResource Space32}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Selection" Background="Transparent" CornerRadius="{StaticResource RadiusRow}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Selection" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextAccentBrush}" />
                                                        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemibold}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </UniformGrid.Resources>
                            <RadioButton x:Name="IntervalOption" GroupName="Timing" Content="Interval" Checked="Timing_Checked" />
                            <RadioButton x:Name="ClockOption" GroupName="Timing" Content="Clock times" Checked="Timing_Checked" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="ClockTimingHelp" Style="{StaticResource Text.Help}" Text="On the hour and half-hour" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="IntervalField" Margin="{StaticResource GapFieldToField}">
                    <TextBlock x:Name="IntervalLabel" Style="{StaticResource Text.Label}" Text="Check in every" />
                    <ComboBox x:Name="IntervalSelect" Style="{StaticResource IntervalSelect}"
                              AutomationProperties.LabeledBy="{Binding ElementName=IntervalLabel}"
                              SelectionChanged="Interval_SelectionChanged" DropDownOpened="IntervalSelect_DropDownOpened">
                        <!-- Shown above the intervals in the drop-down. Not a tab stop there: More options has the same switch -->
                        <ComboBox.Tag>
                            <StackPanel>
                                <CheckBox x:Name="HalfHourBox" Style="{StaticResource TickBox}" Focusable="False"
                                          AutomationProperties.Name="On the half hour and hour"
                                          Checked="HalfHourBox_Changed" Unchecked="HalfHourBox_Changed">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="On the half hour and hour" /><Run x:Name="HalfHourMarks" Text=" (9:30 &amp; 10:00)"
                                            FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </TextBlock>
                                </CheckBox>
                                <Separator Style="{StaticResource Menu.Separator}" />
                            </StackPanel>
                        </ComboBox.Tag>
                    </ComboBox>
                    <TextBlock x:Name="IntervalHelp" Style="{StaticResource Text.Help}" Text="First check-in at 10:00 AM" />
                </StackPanel>

                <!-- Settings only, an outlined row with its switch. Saved, but it doesn't change the widget yet -->
                <Border x:Name="LargerTextRow" Margin="{StaticResource GapFieldToField}" Height="{StaticResource SizeControl}"
                        Padding="16,0,8,0" CornerRadius="{StaticResource RadiusControl}" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderControlBrush}"
                        BorderThickness="{DynamicResource BorderWidth}">
                    <DockPanel>
                        <ToggleButton x:Name="LargerTextSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=LargerTextLabel}"
                                      Checked="LargerText_Changed" Unchecked="LargerText_Changed" />
                        <TextBlock x:Name="LargerTextLabel" Text="Larger text and buttons" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Button x:Name="AdvancedRow" Style="{StaticResource NavRow}" Margin="{StaticResource GapFieldToField}"
                        Click="OpenAdvanced_Click">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="AdvancedSummary" Text="Pill, visible" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <controls:Icon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="More options" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <Button x:Name="AiSettingsRow" Style="{StaticResource NavRow}" Margin="{StaticResource GapFieldToField}"
                        Visibility="Collapsed" Click="AiSettings_Click">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="AiSummary" Text="Not set up" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <controls:Icon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Voice and AI" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- Settings only: clients, projects and activities, so nobody needs a database editor -->
                <Button x:Name="ManageListsRow" Style="{StaticResource NavRow}" Margin="{StaticResource GapStacked}"
                        Visibility="Collapsed" Click="ManageLists_Click">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Rename, hide, add" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <controls:Icon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Manage lists" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- Setup only: "Yesterday isn't sent yet" with Send now -->
                <views:UnsentEarlierDayView x:Name="EarlierNotice" />

                <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource GapSection}"
                        Content="Start tracking" Click="Primary_Click" />
                <Button x:Name="HelpButton" Style="{StaticResource Button.Text}" Margin="{StaticResource GapStacked}"
                        Content="Help" Click="Help_Click" />
            </StackPanel>

            <StackPanel x:Name="AdvancedView" Visibility="Collapsed">
                <DockPanel Margin="-8,0,0,0">
                    <Button x:Name="AdvancedBack" Style="{StaticResource Button.Icon}" ToolTip="Back"
                            AutomationProperties.Name="Back to setup" Click="CloseAdvanced_Click">
                        <controls:Icon Kind="ChevronLeft" />
                    </Button>
                    <TextBlock Style="{StaticResource Text.Title}" Text="More options" Margin="4,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Margin="{StaticResource GapSection}">
                    <TextBlock x:Name="VisibilityLabel" Style="{StaticResource Text.Label}" Text="When idle" />
                    <Grid AutomationProperties.LabeledBy="{Binding ElementName=VisibilityLabel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="VisibleOption" Grid.Column="0" Style="{StaticResource Option}" Content="Visible" Checked="Visibility_Checked" />
                        <RadioButton x:Name="FadedOption" Grid.Column="2" Style="{StaticResource Option}" Content="Faded" Checked="Visibility_Checked" />
                        <RadioButton x:Name="HiddenOption" Grid.Column="4" Style="{StaticResource Option}" Content="Hidden" Checked="Visibility_Checked" />
                    </Grid>
                    <TextBlock x:Name="VisibilityHelp" Style="{StaticResource Text.Help}" Text="Always visible in the corner." />
                </StackPanel>

                <StackPanel Margin="{StaticResource GapFieldToField}">
                    <TextBlock x:Name="ShapeLabel" Style="{StaticResource Text.Label}" Text="Idle shape" />
                    <Grid AutomationProperties.LabeledBy="{Binding ElementName=ShapeLabel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="PillOption" Grid.Column="0" Style="{StaticResource Option}" Content="Pill"
                                     controls:Field.Glyph="ShapePill" Checked="Shape_Checked" />
                        <RadioButton x:Name="RingOption" Grid.Column="2" Style="{StaticResource Option}" Content="Ring"
                                     controls:Field.Glyph="ShapeRing" Checked="Shape_Checked" />
                        <RadioButton x:Name="DotOption" Grid.Column="4" Style="{StaticResource Option}" Content="Dot"
                                     controls:Field.Glyph="ShapeDot" Checked="Shape_Checked" />
                    </Grid>
                    <TextBlock x:Name="ShapeHelp" Style="{StaticResource Text.Help}" Text="Shows the time left." />
                </StackPanel>

                <!-- The working days list, on a screen of its own -->
                <Button x:Name="WorkingDaysRow" Style="{StaticResource PlainRow}" Margin="{StaticResource Space4Top}"
                        Click="WorkingDays_Click">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="WorkingDaysSummary" Text="Mon – Fri" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <controls:Icon Kind="ChevronRight" Size="{StaticResource SizeIconSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Working days" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <DockPanel Margin="{StaticResource Space4Top}" MinHeight="{StaticResource SizeControl}">
                    <ToggleButton x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                  AutomationProperties.LabeledBy="{Binding ElementName=SoundLabel}"
                                  Checked="Sound_Changed" Unchecked="Sound_Changed" />
                    <TextBlock x:Name="SoundLabel" Text="Sound on check-in" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Margin="{StaticResource Space4Top}">
                    <DockPanel MinHeight="{StaticResource SizeControl}">
                        <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                      AutomationProperties.LabeledBy="{Binding ElementName=StartupLabel}"
                                      Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        <TextBlock x:Name="StartupLabel" Text="Start with Windows" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="StartupHelp" Style="{StaticResource Text.Help}" Text="Opens when you sign in to Windows." />
                    <TextBlock x:Name="StartupError" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <Button Style="{StaticResource Button.Primary}" Margin="{StaticResource GapSection}" Content="Done"
                        Click="CloseAdvanced_Click" />
            </StackPanel>
        </Grid>
    </controls:WidgetCard>
</UserControl>

