<UserControl x:Class="TimePlanner.Widget.Views.DayEndedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
             xmlns:views="clr-namespace:TimePlanner.Widget.Views">

    <controls:WidgetCard x:Name="Card" Padding="{StaticResource ShellPaddingWithFoot}" AutomationProperties.Name="Day ended">
        <controls:WidgetCard.CornerContent>
            <Button Style="{StaticResource Button.IconWord}" controls:WidgetCard.Word="Close" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click">
                <controls:Icon Kind="Close" />
            </Button>
        </controls:WidgetCard.CornerContent>

        <StackPanel>
            <DockPanel>
                <Border Style="{StaticResource Badge}" Margin="0,0,16,0">
                    <controls:Icon Kind="Check" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Day ended" />
                    <TextBlock x:Name="DateText" Style="{StaticResource Text.Subtitle}" Text="Friday 23 Oct · ended at 5:30 PM" />
                </StackPanel>
            </DockPanel>

            <!-- Left open overnight: the widget closed it at the last activity and says so -->
            <Border x:Name="OvernightNote" Style="{StaticResource Stat}" Padding="12" Margin="{StaticResource GapFieldToField}"
                    Visibility="Collapsed">
                <DockPanel>
                    <controls:Icon Kind="Info" Size="{StaticResource SizeIconSm}" DockPanel.Dock="Left" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="OvernightText" Style="{StaticResource Text.Body}"
                               Text="It was left open overnight, so it ended at 5:42 PM, your last activity." />
                </DockPanel>
            </Border>

            <Grid Margin="{StaticResource GapSection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock x:Name="LoggedValue" Style="{StaticResource Text.Stat}" Text="7h 30m" />
                        <TextBlock Style="{StaticResource Text.StatLabel}" Text="Logged" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock x:Name="EntriesValue" Style="{StaticResource Text.Stat}" Text="8" />
                        <TextBlock Style="{StaticResource Text.StatLabel}" Text="Entries" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="EmptyHelp" Style="{StaticResource Text.Help}" Visibility="Collapsed"
                       Text="There is nothing to export. Resume the day if you are still working." />

            <!-- Today's day: "Timesheet not sent yet". An earlier day: "Yesterday isn't sent yet" with Send now -->
            <views:UnsentDayReminderView x:Name="ReminderNotice" />
            <views:UnsentEarlierDayView x:Name="EarlierNotice" />

            <!-- Ended today, with entries -->
            <StackPanel x:Name="ExportActions" Margin="{StaticResource GapSection}">
                <Button x:Name="BuildMyDayExportButton" Style="{StaticResource Button.Primary}" Visibility="Collapsed"
                        Margin="0,0,0,8" Click="BuildMyDay_Click" />
                <Button x:Name="ExportButton" Style="{StaticResource Button.Primary}" AutomationProperties.Name="Export CSV" Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="Download" Size="{StaticResource SizeIconSm}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Hidden while the not-sent row above shows, which opens the timesheet itself -->
                <Button x:Name="OpenTimesheetButton" Style="{StaticResource Button.Secondary}" Margin="{StaticResource GapStacked}"
                        Content="Open timesheet" Click="OpenTimesheet_Click" />
                <Grid Style="{StaticResource FootRow}">
                    <Button x:Name="ResumeButton" Style="{StaticResource Button.Text}" Content="Resume day" Click="Resume_Click" />
                </Grid>
            </StackPanel>

            <!-- Ended today, nothing logged -->
            <StackPanel x:Name="EmptyActions" Margin="{StaticResource GapSection}" Visibility="Collapsed">
                <Button x:Name="BuildMyDayEmptyButton" Style="{StaticResource Button.Primary}" Visibility="Collapsed"
                        Margin="0,0,0,8" Click="BuildMyDay_Click" />
                <Button x:Name="ResumeDayEmptyButton" Style="{StaticResource Button.Primary}" Content="Resume day" Click="Resume_Click" />
                <Button x:Name="OpenTimesheetEmptyButton" Style="{StaticResource Button.Secondary}" Margin="{StaticResource GapStacked}" Content="Open timesheet"
                        Click="OpenTimesheet_Click" />
            </StackPanel>

            <!-- The date has changed: today starts fresh, and the ended day is one click away -->
            <StackPanel x:Name="EarlierActions" Margin="{StaticResource GapSection}" Visibility="Collapsed">
                <Button x:Name="StartTodayButton" Style="{StaticResource Button.Primary}" Content="Start today" Click="StartToday_Click" />
                <Button x:Name="EarlierTimesheetButton" Style="{StaticResource Button.Secondary}" Margin="{StaticResource GapStacked}"
                        Content="Open timesheet" Click="OpenTimesheet_Click" />
                <Grid x:Name="EarlierExportRow" Style="{StaticResource FootRow}">
                    <Button Style="{StaticResource Button.Text}" Content="Export CSV" Click="Export_Click" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </controls:WidgetCard>
    </UserControl>
