<UserControl x:Class="TimePlanner.Widget.Views.EntryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimePlanner.Widget.Controls"
             xmlns:models="clr-namespace:TimePlanner.Widget.Models">
    
    <controls:WidgetCard x:Name="Card">
        <controls:WidgetCard.CornerContent>
            <Button Style="{StaticResource Button.Icon}" ToolTip="Cancel"
                    AutomationProperties.Name="Cancel" controls:LargeView.Word="Close" Click="Cancel_Click">
                <controls:Icon Kind="Close" />
            </Button>
        </controls:WidgetCard.CornerContent>

        <StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" Text="Edit entry" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Subtitle}" Text="Tuesday, Sep 28" />
            </StackPanel>

            <Grid Margin="{StaticResource GapSection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Start time" />
                    <TextBox x:Name="StartBox" Style="{StaticResource Input}" controls:Field.Placeholder="09:00" TextChanged="Fields_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Label}" Text="End time" />
                    <TextBox x:Name="EndBox" Style="{StaticResource Input}" controls:Field.Placeholder="09:30" TextChanged="Fields_Changed" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="{StaticResource GapFieldToField}">
                <TextBlock Style="{StaticResource Text.Label}" Text="Client › Project" />
                <controls:ActivityPicker x:Name="ProjectPicker" SelectionChanged="Project_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="{StaticResource GapFieldToField}">
                <TextBlock Style="{StaticResource Text.Label}" Text="Activity" />
                <controls:ActivityPicker x:Name="ActivityPicker" SelectionChanged="Activity_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="{StaticResource GapFieldToField}">
                <TextBlock Style="{StaticResource Text.Label}">
                    <Run Text="Note " /><Run Style="{StaticResource Run.Optional}" Text="(optional)" />
                </TextBlock>
                <TextBox x:Name="NoteBox" Style="{StaticResource TextArea}" controls:Field.Placeholder="What did you work on?"
                         MaxLength="500" TextChanged="Fields_Changed" />
            </StackPanel>

            <StackPanel x:Name="ErrorLine" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" />
            </StackPanel>

            <!-- Shown instead of saving when the edit would change other entries: the user says yes or no first -->
            <Border x:Name="ConfirmBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6"
                    Background="{StaticResource ActionBrush}" CornerRadius="{StaticResource RadiusControl}">
                <StackPanel>
                    <TextBlock x:Name="BannerText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextOnActionBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BannerYes" Style="{StaticResource Button.Text}" Content="Yes" FontWeight="Bold"
                                Foreground="{StaticResource TextOnActionBrush}" AutomationProperties.Name="Yes, change the other entries too"
                                Click="BannerYes_Click" />
                        <Button Style="{StaticResource Button.Text}" Content="No" Margin="8,0,0,0"
                                Foreground="{StaticResource TextOnActionBrush}" AutomationProperties.Name="No, keep editing"
                                Click="BannerNo_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <controls:WidgetCard.Foot>
            <StackPanel Margin="{StaticResource GapSection}">
                <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" Content="Save" Click="Save_Click" />
                <Button Style="{StaticResource Button.Text}" Content="Cancel" Margin="0,4,0,0" Click="Cancel_Click" />
            </StackPanel>
        </controls:WidgetCard.Foot>
    </controls:WidgetCard>
</UserControl>
