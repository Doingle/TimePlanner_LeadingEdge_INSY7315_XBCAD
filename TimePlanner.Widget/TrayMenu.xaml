<ContextMenu x:Class="TimePlanner.Widget.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HasDropShadow="False" OverridesDefaultStyle="True"
             Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontFamily}"
             FontSize="{StaticResource FontSizeBody}" ItemContainerStyle="{StaticResource Menu.Row}">
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Grid Margin="12">
                <Border Style="{StaticResource Menu.Shadow}" />
                <Border Style="{StaticResource Menu.Panel}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                </Border>
            </Grid>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
