<Window x:Class="TimePlanner.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimePlanner.Widget"
        xmlns:views="clr-namespace:TimePlanner.Widget.Views"
        Title="INSY"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Left="-32000" Top="-32000"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <!-- Large view scales this, inside the shadow margin, so every screen and its click areas grow together -->
    <Grid x:Name="Root" Margin="{x:Static local:MainWindow.ShadowMargin}">
        <ContentControl x:Name="Host" Focusable="False" IsTabStop="False" />
        <views:UpdateAvailableView x:Name="UpdateNotice" Visibility="Collapsed" />
    </Grid>
</Window>
