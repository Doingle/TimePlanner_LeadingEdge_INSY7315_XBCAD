<!-- SHELL: the card every screen sits in, and the small shared pieces inside it. -->
    
    <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 320 wide, 1px subtle outline, 16 radius, shell shadow. Padding 24 / 16 / 16

        The shadows are drawn by separate "caster" borders hidden behind the card rather than by an effect on the card itself.
        Raised glows: a bright light glow at the edge and a wider bloom, over a dark halo and a deep drop.
        CSS stacks shadows on one element; WPF needs one element per shadow.

        Banner: an optional full-width band inside the outline, above the padded content (the dark welcome header on Setup). -->

    <Style TargetType="controls:WidgetCard">
        <Setter Property="Width" Value="{StaticResource WidgetWidth}" />
        <Setter Property="Padding" Value="{StaticResource ShellPadding}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
        <Setter Property="GripBrush" Value="{StaticResource HandleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />

        <!-- Main Template -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WidgetCard">
                    <Grid>
                        <!-- Raised -->
                        <Border x:Name="RaisedDrop" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedDrop}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedHalo" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedHalo}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedGlow" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedGlow}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedGlowEdge" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedGlowEdge}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        
                        <!-- Everyday shell shadow -->
                        <Border x:Name="Shadow" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowShell}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>

                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusShell}"
                            RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Banner: lets pointer input through -->
                                <ContentPresenter Grid.Row="0" Content="{TemplateBinding Banner}" IsHitTestVisible="False" />

                                <!-- The middle. It only scrolls when the card would be taller than the screen above the taskbar,
                                     with a thin bar in the right margin -->
                                <ScrollViewer x:Name="PART_Scroll" Grid.Row="1" Focusable="False" Background="Transparent"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                                                <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right"
                                                           Margin="0,4,5,4" Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <DockPanel Margin="{TemplateBinding ContentPadding}">
                                        <!-- Status line on the time-tracking cards: a dot, green while tracking and grey otherwise,
                                             then the date. The state is also in words for screen readers and the tooltip -->
                                        <StackPanel x:Name="StatusLine" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,88,8"
                                                    Background="Transparent"
                                                    ToolTip="{Binding Path=(controls:WidgetCard.Status).Spoken, RelativeSource={RelativeSource TemplatedParent}}"
                                                    AutomationProperties.Name="{Binding Path=(controls:WidgetCard.Status).Spoken, RelativeSource={RelativeSource TemplatedParent}}"
                                                    AutomationProperties.LiveSetting="Polite">
                                            <Ellipse x:Name="StatusDot" Width="{StaticResource Space8}" Height="{StaticResource Space8}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource BorderControlBrush}" />
                                            <TextBlock Text="{Binding Path=(controls:WidgetCard.Status).Date, RelativeSource={RelativeSource TemplatedParent}}"
                                                       FontSize="{StaticResource FontSizeBody}" LineHeight="{StaticResource LineHeightBody}"
                                                       LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ContentPresenter />
                                    </DockPanel>
                                </ScrollViewer>

                                <!-- Foot: the bottom buttons, pinned under the middle -->
                                <Grid x:Name="FootArea" Grid.Row="2">
                                    <Border x:Name="FootLine" Height="{DynamicResource Hairline}" VerticalAlignment="Top"
                                            Background="{StaticResource BorderSubtleBrush}" Visibility="Collapsed" />
                                    <ContentPresenter Margin="{TemplateBinding FootPadding}" Content="{TemplateBinding Foot}" />
                                </Grid>

                                <!-- The top 24px moves the window -->
                                <Border x:Name="PART_DragArea" Grid.RowSpan="3" Height="{StaticResource Space24}" VerticalAlignment="Top"
                                    Background="Transparent" />

                                <!-- Grip: 32 x 4, centred, 8 from the top -->
                                <Border x:Name="PART_Grip" Grid.RowSpan="3" Width="{StaticResource Space32}" Height="{StaticResource Space4}"
                                    Margin="0,8,0,0" CornerRadius="{StaticResource RadiusGrip}" Background="{TemplateBinding GripBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeAll" ToolTip="Drag to move" />

                                <!-- Corner button: 16 from the top, 8 from the right. In large view its word sits under the icon -->
                                <ContentPresenter Grid.RowSpan="3" Content="{TemplateBinding CornerContent}" Margin="0,16,8,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" controls:LargeView.WordBelow="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRaised" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RaisedDrop" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedHalo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedGlow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedGlowEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="controls:WidgetCard.Status" Value="{x:Null}">
                            <Setter TargetName="StatusLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CornerContent" Value="{x:Null}">
                            <Setter TargetName="StatusLine" Property="Margin" Value="0,0,0,8" />
                        </Trigger>
                        <Trigger Property="Foot" Value="{x:Null}">
                            <Setter TargetName="FootArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="FootDivider" Value="True">
                            <Setter TargetName="FootLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_Scroll" Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter TargetName="FootLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=(controls:WidgetCard.Status).Live, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LiveBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon badge: 40px circle on the subtle surface, 20px icon -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource SizeBadge}" />
        <Setter Property="Height" Value="{StaticResource SizeBadge}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Day stat tile -->
    <Style x:Key="Stat" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
    </Style>

    <!-- Text-button row: one 40px row; a lone text button centres in it -->
    <Style x:Key="FootRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource SizeControl}" />
    </Style>

</ResourceDictionary>