<!-- SHELL: the card every screen sits in, and the small shared pieces inside it. -->
    
    <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controls="clr-namespace:TimePlanner.Widget.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 320 wide, 1px subtle outline, 16 radius, shell shadow. Padding 24 / 16 / 16

        The shadows are drawn by separate "caster" borders hidden behind the card rather than by an effect on the card itself.
        Raised glows: a bright light glow at the edge and a wider bloom, over a dark halo and a deep drop.
        CSS stacks shadows on one element; WPF needs one element per shadow.

        Banner: an optional full-width band inside the outline, above the padded content (the dark welcome header on Setup). -->

    <Style TargetType="controls:WidgetCard">
        <Setter Property="Width" Value="{StaticResource WidgetWidth}" />
        <Setter Property="Padding" Value="{StaticResource ShellPadding}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderWidth}" />
        <Setter Property="GripBrush" Value="{StaticResource HandleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />

        <!-- Main Template -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WidgetCard">
                    <Grid>
                        <!-- Raised -->
                        <Border x:Name="RaisedDrop" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedDrop}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedHalo" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedHalo}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedGlow" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedGlow}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="RaisedGlowEdge" Visibility="Collapsed" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowRaisedGlowEdge}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>
                        
                        <!-- Everyday shell shadow -->
                        <Border x:Name="Shadow" CornerRadius="{StaticResource RadiusShell}"
                            Background="{StaticResource SurfaceBrush}" Effect="{StaticResource ShadowShell}">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                        </Border>

                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusShell}"
                            RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <!-- The top 24px moves the window -->
                                <Border x:Name="PART_DragArea" Grid.RowSpan="2" Height="{StaticResource Space24}" VerticalAlignment="Top"
                                    Background="Transparent" />
                                
                                <!-- Banner: lets pointer input through -->
                                <ContentPresenter Grid.Row="0" Content="{TemplateBinding Banner}" IsHitTestVisible="False" />
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                                
                                <!-- Grip: 32 x 4, centred, 8 from the top -->
                                <Border x:Name="PART_Grip" Grid.RowSpan="2" Width="{StaticResource Space32}" Height="{StaticResource Space4}"
                                    Margin="0,8,0,0" CornerRadius="{StaticResource RadiusGrip}" Background="{TemplateBinding GripBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeAll" ToolTip="Drag to move" />
                                
                                <!-- Corner button: 16 from the top, 8 from the right -->
                                <ContentPresenter Grid.RowSpan="2" Content="{TemplateBinding CornerContent}" Margin="0,16,8,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRaised" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RaisedDrop" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedHalo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedGlow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedGlowEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon badge: 40px circle on the subtle surface, 20px icon -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource SizeBadge}" />
        <Setter Property="Height" Value="{StaticResource SizeBadge}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Day stat tile -->
    <Style x:Key="Stat" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
    </Style>

    <!-- Text-button row: one 40px row; a lone text button centres in it -->
    <Style x:Key="FootRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource SizeControl}" />
    </Style>

</ResourceDictionary>