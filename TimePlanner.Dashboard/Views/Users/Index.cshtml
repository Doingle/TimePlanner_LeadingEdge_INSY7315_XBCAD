@using System.Globalization
@using TimePlanner.Dashboard.Security
@model UsersPageModel
@{
    ViewData["Title"] = "Users";
    ViewData["Nav"] = "Admin";
    Layout = "_AppLayout";
    var culture = CultureInfo.InvariantCulture;
    var me = User.IdentityId();
    var active = Model.Users.Count(u => u.IsActive);
    var deactivated = Model.Users.Count - active;
    var messages = Model.Message != null || Model.Error != null || Model.TemporaryPassword != null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
}

@section Hero {
    <section class="tm-hero" aria-labelledby="tm-page-title">
        <div class="tm-hero__inner">
            <partial name="_TeamNav" model="@("Users", (string?)null, (DateTime?)null)" />

            <h1 class="tm-hero__title" id="tm-page-title">Users</h1>
            <p class="tm-hero__intro">Create accounts, reset passwords, and deactivate or reactivate people.</p>
            <p class="tm-hero__counts">@active active, @deactivated deactivated</p>
        </div>
    </section>
}

<section class="tm-section" aria-label="Messages and new accounts">
    @if (messages)
    {
        @* one status line, and the temporary password when there is one. The password is only on this response, it is not kept anywhere *@
        <div class="tm-messages">
            @if (Model.Message != null)
            {
                <p class="tm-status tm-status--ok" role="status">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    <span>@Model.Message</span>
                </p>
            }
            @if (Model.Error != null)
            {
                <p class="tm-status tm-status--error" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6M9 9l6 6" /></svg>
                    <span>@Model.Error</span>
                </p>
            }
            @if (Model.TemporaryPassword != null)
            {
                <section class="tm-temp" aria-labelledby="tm-temp-title">
                    <h2 class="tm-temp__title" id="tm-temp-title">Temporary password for @Model.TemporaryFor</h2>
                    <code class="tm-temp__code">@Model.TemporaryPassword</code>
                    <p class="tm-temp__warn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></svg>
                        <span>This is the only time it's shown. Give it to them in person or another secure way. They'll choose their own password when they first sign in.</span>
                    </p>
                </section>
            }
        </div>
    }

    <div class="tm-panel tm-create">
        <h2 class="tm-section__title" id="tm-create-title">Create an account</h2>
        @* the api has a UsersController with a Create action too, at api/v1/users. Naming the default route keeps this form on /Users/Create *@
        <form class="tm-create__form" method="post" asp-route="default" asp-route-controller="Users" asp-route-action="Create" aria-labelledby="tm-create-title">
            <div class="tm-field">
                <label class="tm-label" for="name">Name</label>
                <input class="tm-input tm-input--name" id="name" name="name" maxlength="100" required autocomplete="off" />
            </div>
            <div class="tm-field">
                <label class="tm-label" for="email">Email</label>
                <input class="tm-input tm-input--email" id="email" name="email" type="email" maxlength="256" required autocomplete="off" spellcheck="false" />
            </div>
            @* two roles, shown as a pair of options rather than a dropdown *@
            <div class="tm-field">
                <span class="tm-label" id="tm-role-label">Role</span>
                <div class="tm-choice" role="radiogroup" aria-labelledby="tm-role-label">
                    <label class="tm-choice__option"><input type="radio" name="role" value="Developer" checked />Developer</label>
                    <label class="tm-choice__option"><input type="radio" name="role" value="Admin" />Admin</label>
                </div>
            </div>
            <button class="tm-button" type="submit">Create account</button>
        </form>
    </div>
</section>

<section class="tm-section" aria-labelledby="tm-everyone-title">
    <div class="tm-people-head">
        <h2 class="tm-section__title" id="tm-everyone-title">Everyone</h2>
        <p>Sign-in times are in UTC.</p>
    </div>
    <div class="tm-panel">
        <table class="tm-users">
            <caption class="app-sr-only">All accounts</caption>
            <thead>
                <tr>
                    <th scope="col">Person</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last sign in</th>
                    <th scope="col"><span class="app-sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var you = user.Id == me;
                    <tr class="tm-users__row @(user.IsActive ? null : "tm-users__row--off")">
                        <th scope="row" class="tm-users__who"><strong>@(user.Name)@if (you) {<span class="tm-users__you">(you)</span>}</strong><span>@user.Email</span></th>
                        <td class="tm-users__role">@user.Role</td>
                        @* an active account is plain text, only the exceptions get a tag *@
                        <td class="tm-users__state">
                            <div class="tm-tags">
                                @if (user.IsActive)
                                {
                                    <span class="tm-tag tm-tag--plain">Active</span>
                                }
                                else
                                {
                                    <span class="tm-tag tm-tag--off">Deactivated</span>
                                }
                                @if (user.MustChangePassword)
                                {
                                    <span class="tm-tag tm-tag--temp">Temporary password</span>
                                }
                                @if (user.LockedOut)
                                {
                                    <span class="tm-tag tm-tag--locked"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>Locked out</span>
                                }
                            </div>
                        </td>
                        <td class="tm-users__when @(user.LastLoginUtc == null ? "tm-users__when--never" : null)">@(user.LastLoginUtc == null ? "Never" : $"{user.LastLoginUtc.Value.ToString("d MMM yyyy, HH:mm", culture)} UTC")</td>
                        <td class="tm-users__acts">
                            <form method="post" asp-controller="Users" asp-action="ResetPassword">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="tm-small-button" aria-label="Reset password for @user.Name">Reset password</button>
                            </form>
                            @if (!user.IsActive)
                            {
                                <form method="post" asp-controller="Users" asp-action="Reactivate">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="tm-small-button" aria-label="Reactivate @user.Name">Reactivate</button>
                                </form>
                            }
                            else if (!you)
                            {
                                @* quiet until hovered, a column of red buttons would shout. Nobody can deactivate their own account *@
                                <form method="post" asp-controller="Users" asp-action="Deactivate">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="tm-small-button tm-small-button--quiet" aria-label="Deactivate @user.Name">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
