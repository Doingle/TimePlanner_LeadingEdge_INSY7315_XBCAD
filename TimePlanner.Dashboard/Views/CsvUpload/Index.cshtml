@using TimePlanner.Dashboard.Services.TimesheetImport
@model ImportResult?
@{
    ViewData["Title"] = "Upload timesheet";
    ViewData["Nav"] = "Reports";
    Layout = "_AppLayout";
    var ok = Model != null && Model.Success;
    var rowErrors = Model?.Errors.Any(e => e.Row > 0) == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/upload.css" asp-append-version="true" />
}

@* uploading usually happens in the dialog on My Reports. This page is where its button leads without the script, and where a plain post lands:
   the same panel as the dialog, sitting on the page. The result block is also what the dialog reads from the answer to its post *@
<div class="up-page">
    <section class="up-modal up-modal--page" aria-labelledby="up-title">
        <header class="up-modal__head">
            <h1 class="up-modal__title" id="up-title">Upload timesheet</h1>
            <a class="up-modal__close" asp-controller="Report" asp-action="Index" asp-route-view="week" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </a>
        </header>

        @if (Model == null)
        {
            <form class="up-modal__form" method="post" enctype="multipart/form-data" asp-action="Index" data-upload-form>
                <div class="up-modal__body">
                    <partial name="_UploadPick" />
                </div>
                <footer class="up-modal__foot">
                    <a class="up-button up-button--secondary" asp-controller="Report" asp-action="Index" asp-route-view="week">Cancel</a>
                    <button type="submit" class="up-button up-button--primary">
                        <svg class="up-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21V9M7 14l5-5 5 5M5 3h14" /></svg>
                        Upload
                    </button>
                </footer>
            </form>
        }
        else
        {
            <div class="up-modal__body">
                <partial name="_UploadResult" model="Model" />
            </div>
            <footer class="up-modal__foot">
                @if (ok)
                {
                    <a class="up-button up-button--secondary" asp-action="Index">Upload another file</a>
                    <a class="up-button up-button--primary" asp-controller="Report" asp-action="Index" asp-route-view="week">Done</a>
                }
                else
                {
                    <a class="up-button up-button--secondary" asp-controller="Report" asp-action="Index" asp-route-view="week">Close</a>
                    <a class="up-button up-button--primary" asp-action="Index">@(rowErrors ? "Choose the fixed file" : "Choose another file")</a>
                }
            </footer>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
}
