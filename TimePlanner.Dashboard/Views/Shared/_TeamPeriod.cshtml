@using System.Globalization
@using TimePlanner.Dashboard.Services
@inject CompanyClock Clock
@* the Team pages' period controls, on the ink header: the previous and next week or month, and week or month as links.
   the model is (action on the Admin controller, view = "week" or "month", label, previous date, next date) *@
@model (string Action, string View, string Label, DateTime Previous, DateTime Next)
@{
    var culture = CultureInfo.InvariantCulture;
    var week = Model.View == "week";
    var unit = week ? "week" : "month";
    //nothing has happened after the current week or month yet, so there is no next one to open
    var hasNext = Model.Next <= Clock.Today;
}

<div class="tm-controls">
    <div class="tm-period">
        <a class="tm-icon-button" asp-controller="Admin" asp-action="@Model.Action" asp-route-view="@Model.View" asp-route-date="@Model.Previous.ToString("yyyy-MM-dd", culture)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            <span class="app-sr-only">Previous @unit</span>
        </a>
        <p class="tm-period__label">@Model.Label</p>
        @if (hasNext)
        {
            <a class="tm-icon-button" asp-controller="Admin" asp-action="@Model.Action" asp-route-view="@Model.View" asp-route-date="@Model.Next.ToString("yyyy-MM-dd", culture)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                <span class="app-sr-only">Next @unit</span>
            </a>
        }
        else
        {
            <a class="tm-icon-button" role="link" aria-disabled="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                <span class="app-sr-only">Next @unit</span>
            </a>
        }
    </div>

    @* week or month as links: each opens the current one *@
    <nav class="tm-toggle" aria-label="Period length">
        <a class="tm-toggle__option" asp-controller="Admin" asp-action="@Model.Action" asp-route-view="week" aria-current="@(week ? "true" : null)">Week</a>
        <a class="tm-toggle__option" asp-controller="Admin" asp-action="@Model.Action" asp-route-view="month" aria-current="@(week ? null : "true")">Month</a>
    </nav>
</div>
