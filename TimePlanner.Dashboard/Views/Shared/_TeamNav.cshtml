@using System.Globalization
@* the Team pages' own tabs, on the ink header: Overview, Submissions, Exports and Users. The pages with a period keep it when moving between them.
   the model is (current page, view, first day of the period). Users has no period, so it passes nulls and the tabs open the current week *@
@model (string Current, string? View, DateTime? From)
@{
    var date = Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    string? Current(string page) => Model.Current == page ? "page" : null;
}

<nav class="tm-subnav" aria-label="Team">
    <a class="tm-subnav__link" asp-controller="Admin" asp-action="Index" asp-route-view="@Model.View" asp-route-date="@date" aria-current="@Current("Overview")">Overview</a>
    <a class="tm-subnav__link" asp-controller="Admin" asp-action="Submissions" asp-route-view="@Model.View" asp-route-date="@date" aria-current="@Current("Submissions")">Submissions</a>
    <a class="tm-subnav__link" asp-controller="Admin" asp-action="Exports" asp-route-view="@Model.View" asp-route-date="@date" aria-current="@Current("Exports")">Exports</a>
    <a class="tm-subnav__link" asp-controller="Users" asp-action="Index" aria-current="@Current("Users")">Users</a>
</nav>
