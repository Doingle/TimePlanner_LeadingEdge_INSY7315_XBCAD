@* the upload timesheet dialog, opened by any [data-upload-open] link on the page (the link still goes to /CsvUpload without the script).
   a native <dialog> opened with showModal(): focus stays inside, the page behind can't be clicked or tabbed to, and Esc closes it like the X does.
   clicking the dimmed page does not close it, so an error list can't be lost to a stray click.
   the form posts to the same /CsvUpload handler as the page; upload.js sends it with fetch and shows the result block from the answer.
   a page that uses it adds upload.css and upload.js *@
<dialog class="up-modal" id="up-dialog" aria-labelledby="up-title" data-upload-dialog>
    <form class="up-modal__form" method="post" enctype="multipart/form-data" novalidate asp-controller="CsvUpload" asp-action="Index" data-upload-form>
        <header class="up-modal__head">
            <h2 class="up-modal__title" id="up-title">Upload timesheet</h2>
            <button type="button" class="up-modal__close" aria-label="Close" data-upload-close>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </header>

        <div class="up-modal__body">
            <div data-upload-step="pick">
                <partial name="_UploadPick" />
            </div>
            <div data-upload-step="result" hidden></div>
        </div>

        @* the buttons for each step are all here, upload.js shows the ones for the step the dialog is on *@
        <footer class="up-modal__foot" data-upload-foot>
            <button type="button" class="up-button up-button--secondary" data-upload-close data-upload-for="pick">Cancel</button>
            <button type="submit" class="up-button up-button--primary" data-upload-submit data-upload-for="pick busy">
                <span class="up-spinner" aria-hidden="true" data-upload-busy hidden></span>
                <svg class="up-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-upload-idle><path d="M12 21V9M7 14l5-5 5 5M5 3h14" /></svg>
                <span data-upload-idle>Upload</span>
                <span data-upload-busy hidden>Uploading…</span>
            </button>
            <button type="button" class="up-button up-button--secondary" data-upload-again data-upload-for="done" hidden>Upload another file</button>
            <button type="button" class="up-button up-button--primary" data-upload-close data-upload-for="done" hidden>Done</button>
            <button type="button" class="up-button up-button--secondary" data-upload-close data-upload-for="fail" hidden>Close</button>
            <button type="button" class="up-button up-button--primary" data-upload-again="pick" data-upload-for="fail" hidden>Choose the fixed file</button>
        </footer>
        <p class="app-sr-only" role="status" data-upload-live></p>
    </form>
</dialog>
