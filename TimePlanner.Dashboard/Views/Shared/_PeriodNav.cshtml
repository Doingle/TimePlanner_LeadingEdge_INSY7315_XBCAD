@using System.Globalization
@* week or month, with the previous and next period. Used by My Timesheet and the admin pages.
   the model is a tuple: (controller, action, view = "week" or "month", label, previous date, next date) *@
@model (string Controller, string Action, string View, string Label, DateTime Previous, DateTime Next)
@{
    var culture = CultureInfo.InvariantCulture;
}

<nav class="period-nav mb-3" aria-label="Period">
    <form method="get" asp-controller="@Model.Controller" asp-action="@Model.Action" class="d-inline">
        <div class="period-nav__toggle d-inline-flex" role="group" aria-label="View">
            <button class="period-nav__option" type="submit" name="view" value="week" aria-pressed="@(Model.View == "week" ? "true" : "false")">Week</button>
            <button class="period-nav__option" type="submit" name="view" value="month" aria-pressed="@(Model.View == "month" ? "true" : "false")">Month</button>
        </div>
    </form>
    <span class="ms-3">
        <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-view="@Model.View" asp-route-date="@Model.Previous.ToString("yyyy-MM-dd", culture)">Previous</a>
        <strong class="mx-2">@Model.Label</strong>
        <a asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-view="@Model.View" asp-route-date="@Model.Next.ToString("yyyy-MM-dd", culture)">Next</a>
    </span>
</nav>
