@using TimePlanner.Dashboard.Services.TimesheetImport
@model ImportResult
@* what an upload did: entries added, nothing new, or the problems that stopped it. Drawn on the /CsvUpload page after a post, and
   the dialog on My Reports sends the same post and lifts this block out of the answer (data-upload-result), so both say exactly the same.
   data-kind picks the dialog's buttons, data-imported says whether the page behind needs to be drawn again *@
@{
    //the file that was sent, so the person can see which one this was about
    var fileName = Context.Request.HasFormContentType ? Context.Request.Form.Files.GetFile("file")?.FileName : null;
    var kind = !Model.Success ? "fail" : Model.Created == 0 ? "none" : "ok";
    var rowErrors = Model.Errors.Count(e => e.Row > 0);
    string Entries(int count) => count == 1 ? "entry" : "entries";
}

<div class="up-result" data-upload-result data-kind="@kind" data-imported="@(Model.Created > 0 ? "true" : "false")"
     data-again="@(rowErrors > 0 ? "Choose the fixed file" : "Choose another file")">
    <div class="up-result__summary" tabindex="-1" data-upload-focus>
        @if (kind == "ok")
        {
            <p class="up-result__status up-result__status--ok">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Imported
            </p>
            <p class="up-result__figure"><span class="up-result__num">@Model.Created</span><span class="up-result__unit">@Entries(Model.Created) added to your timesheet</span></p>
            @if (Model.Skipped > 0)
            {
                <p class="up-result__sub">@Model.Skipped @(Model.Skipped == 1 ? "entry was" : "entries were") already stored, so @(Model.Skipped == 1 ? "it was" : "they were") skipped.</p>
            }
        }
        else if (kind == "none")
        {
            <p class="up-result__status up-result__status--none">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
                Nothing new
            </p>
            <p class="up-result__figure"><span class="up-result__num">@Model.Skipped</span><span class="up-result__unit">@Entries(Model.Skipped) already stored</span></p>
            <p class="up-result__sub">Your timesheet already has everything in this file, so nothing changed.</p>
        }
        else
        {
            <p class="up-result__status up-result__status--fail">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6M9 9l6 6" /></svg>
                Nothing was imported
            </p>
            @if (rowErrors > 0)
            {
                <p class="up-result__figure"><span class="up-result__num">@Model.Errors.Count</span><span class="up-result__unit">@(Model.Errors.Count == 1 ? "problem" : "problems") to fix</span></p>
                <p class="up-result__sub">Fix @(Model.Errors.Count == 1 ? "it" : "them") in the file, then upload the file again.</p>
            }
            else
            {
                @* a problem with the whole file, or the account, rather than with its rows *@
                @foreach (var error in Model.Errors)
                {
                    <p class="up-result__sub">@error.Message</p>
                }
            }
        }
    </div>

    @if (rowErrors > 0)
    {
        <ul class="up-errors" aria-label="Problems to fix">
            @foreach (var error in Model.Errors.Take(50))
            {
                <li class="up-errors__item">
                    @if (error.Row > 0)
                    {
                        <span class="up-errors__row">Row @error.Row</span>
                    }
                    <span class="@(error.Row > 0 ? null : "up-errors__whole")">@error.Message</span>
                </li>
            }
            @if (Model.Errors.Count > 50)
            {
                <li class="up-errors__more">And @(Model.Errors.Count - 50) more. Fix the ones above and upload again to see the rest.</li>
            }
        </ul>
    }

    @if (!string.IsNullOrEmpty(fileName))
    {
        <p class="up-result__file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
            @fileName
        </p>
    }
</div>
